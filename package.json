{
  "name": "hmpps-manage-custody-mailbox-register",
  "version": "0.0.1",
  "description": "HMPPS Manage Custody Mailbox Register",
  "repository": "git@github.com:ministryofjustice/hmpps-manage-custody-mailbox-register.git",
  "license": "MIT",
  "scripts": {
    "prepare": "hmpps-precommit-hooks-prepare",
    "watch-ts": "tsc -w",
    "build": "node esbuild/esbuild.js",
    "start": "node $NODE_OPTIONS dist/server.js | bunyan -o short",
    "start:dev": "node esbuild/esbuild.js --watch",
    "start-feature": " node $NODE_DEBUG_OPTION --env-file=feature.env dist/server.js | bunyan -o short",
    "start-feature:dev": "node esbuild/esbuild.js --watch --env feature.env",
    "lint": "eslint . --cache --max-warnings 0",
    "lint-fix": "eslint . --cache --max-warnings 0 --fix",
    "typecheck": "tsc && tsc -p integration_tests",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "security_audit": "npx audit-ci --config audit-ci.json",
    "int-test": "cypress run --config video=false",
    "int-test-ui": "cypress open --e2e --browser chrome",
    "clean": "rm -rf dist node_modules",
    "rebuild": "npm run clean && npm run setup && npm run build",
    "setup": "npm ci && hmpps-npm-script-run-allowlist"
  },
  "engines": {
    "node": "^24",
    "npm": "^12"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1150.0",
    "@ministryofjustice/frontend": "^11.1.0",
    "@ministryofjustice/hmpps-azure-telemetry": "1.1.0",
    "@ministryofjustice/hmpps-auth-clients": "^3.0.0",
    "@ministryofjustice/hmpps-monitoring": "^2.1.0",
    "@ministryofjustice/hmpps-rest-client": "^2.2.0",
    "@opentelemetry/api": "1.9.0",
    "bunyan": "^1.8.15",
    "bunyan-format": "^0.2.1",
    "compression": "^1.8.2",
    "connect-flash": "^0.1.1",
    "connect-redis": "^10.0.0",
    "csrf-sync": "^4.2.1",
    "date-fns": "^4.4.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "govuk-frontend": "^6.5.1",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "jwt-decode": "^4.0.0",
    "method-override": "^3.0.0",
    "nocache": "^4.0.0",
    "nunjucks": "^3.2.4",
    "passport": "^0.7.0",
    "passport-oauth2": "^1.8.0",
    "redis": "6.3.0",
    "superagent": "^10.4.1"
  },
  "devDependencies": {
    "@jgoz/esbuild-plugin-typecheck": "^5.0.0",
    "@ministryofjustice/eslint-config-hmpps": "^1.0.3",
    "@ministryofjustice/hmpps-npm-script-allowlist": "0.0.6",
    "@ministryofjustice/hmpps-precommit-hooks": "3.0.2",
    "@tsconfig/node24": "^24.0.5",
    "@types/bunyan": "^1.8.11",
    "@types/bunyan-format": "^0.2.9",
    "@types/compression": "^1.8.1",
    "@types/connect-flash": "0.0.40",
    "@types/express-session": "^1.19.0",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/method-override": "^3.0.0",
    "@types/node": "^24.19.1",
    "@types/nunjucks": "^3.2.6",
    "@types/passport": "^1.0.17",
    "@types/passport-oauth2": "^1.8.0",
    "@types/superagent": "^8.1.11",
    "@types/supertest": "^7.2.1",
    "audit-ci": "^7.1.0",
    "aws-sdk-client-mock": "^4.1.0",
    "cypress": "^15.21.1",
    "cypress-multi-reporters": "^2.0.5",
    "esbuild": "^0.28.2",
    "esbuild-plugin-manifest": "^1.0.5",
    "esbuild-sass-plugin": "^3.7.0",
    "jest": "^30.5.2",
    "jest-html-reporter": "^4.4.2",
    "jest-junit": "^17.0.0",
    "jsonwebtoken": "^9.0.3",
    "lint-staged": "^17.6.0",
    "mocha-junit-reporter": "^2.2.1",
    "nock": "^14.0.17",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@humanfs/node": "0.17.0",
    "@opentelemetry/core": "2.11.0",
    "@aws-sdk/xml-builder": {
      "fast-xml-parser": "^5.3.8"
    },
    "baseline-browser-mapping": "2.11.28",
    "brace-expansion": "5.0.12",
    "browserslist": "4.29.3",
    "chokidar": "4.0.3",
    "handlebars": "^4.7.10",
    "immutable": "5.1.9",
    "js-yaml": "4.3.2",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3",
    "flatted": "^3.4.2",
    "path-to-regexp": "^8.4.0",
    "yaml": "^2.8.3",
    "picomatch": "^4.0.4",
    "source-map-js": "1.2.2",
    "systeminformation": "5.33.15",
    "tar": "7.5.22"
  }
}
